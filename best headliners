  .internal-page .page-hero--text .page-hero-content { padding: 36px 0 46px; }
}

/* =============================================================
   [NOMBRE DE LA MARCA] — Homepage
   1. Tokens  2. Reset  3. Utilidades  4. Tipografía  5. Componentes
   6. Header  7. Hero  8. Brands  9. Cars  10. About/Enquire
   11. Blog  12. Footer  13. Responsive  14. Reduced motion
   ============================================================= */

/* =============================================================
   1. Tokens — colores muestreados de la referencia
   ============================================================= */
:root {
  --bg: #0a0a0a;
  --bg-soft: #111111;
  --card-dark: #1c1c1c;
  --card-dark-2: #262626;
  --white: #f5f5f5;
  --grey: #9a9a9a;
  --grey-line: rgba(245, 245, 245, 0.1);
  /* Rojo, azul y cromado muestreados directamente del logo real de Best Headliners Plus */
  --red: #dc0000;
  --red-deep: #c30f1a;
  --red-glow: rgba(220, 0, 0, 0.45);
  --blue: #4981fc;
  --blue-deep: #223b8b;
  --blue-glow: rgba(73, 129, 252, 0.4);
  --chrome-hi: #f0f0f2;
  --chrome-lo: #6b6a6f;

  --font-display: "Jost", "Segoe UI", sans-serif;
  --font-body: "Jost", -apple-system, sans-serif;

  --radius-pill: 999px;
  --container: 1280px;
  --gutter: clamp(1.25rem, 4vw, 2.5rem);

  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);

  --header-h: 100px;
}

/* =============================================================
   2. Reset
   ============================================================= */
*, *::before, *::after { box-sizing: border-box; margin: 0; }
html {
  -webkit-text-size-adjust: 100%;
  overflow-x: clip;
  scroll-behavior: smooth;
  scroll-padding-top: var(--header-h);
}
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
body {
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.65;
  color: var(--white);
  background: var(--bg);
  -webkit-font-smoothing: antialiased;
  overflow-x: clip;
}
img, svg, video { display: block; max-width: 100%; }
img { height: auto; }
button { font: inherit; color: inherit; cursor: pointer; border: 0; background: none; }
a { color: inherit; text-decoration: none; }
ul, ol { list-style: none; padding: 0; }
input, textarea, select { font: inherit; color: inherit; background: none; border: 0; }
h1,h2,h3,h4 { font-family: var(--font-display); line-height: 1.1; text-wrap: balance; }
::selection { background: var(--red); color: #fff; }
:focus-visible { outline: 2px solid var(--red); outline-offset: 3px; border-radius: 4px; }

/* =============================================================
   3. Utilidades
   ============================================================= */
.container { max-width: var(--container); margin-inline: auto; padding-inline: var(--gutter); }
.section { position: relative; padding-block: clamp(3.5rem, 8vw, 7rem); }
.skip-link {
  position: fixed; top: -100px; left: 1rem; padding: .7rem 1.1rem;
  background: var(--white); color: var(--bg); z-index: 9999; border-radius: 8px; font-weight: 600;
  transition: top .3s var(--ease-out);
}
.skip-link:focus { top: 1rem; }

/* Título con patrón: primera palabra light, resto bold */
.split-title { font-weight: 300; font-size: clamp(1.9rem, 4vw, 2.8rem); color: var(--blue); }
.split-title strong, .split-title .bold { font-weight: 700; color: var(--white); }
.split-title .accent { color: var(--red); font-weight: 700; }

/* Texto fantasma gigante detrás de los títulos de sección */
.ghost-wrap { position: relative; text-align: center; margin-bottom: .5rem; }
.ghost-text {
  position: absolute; left: 50%; top: 50%;
  transform: translate(-50%, -54%);
  font-family: var(--font-display); font-weight: 700;
  font-size: clamp(3.5rem, 11vw, 8.5rem);
  color: transparent;
  -webkit-text-stroke: 1px rgba(245,245,245,0.08);
  color: rgba(245,245,245,0.045);
  white-space: nowrap;
  pointer-events: none;
  z-index: 0;
  user-select: none;
}
.ghost-wrap .split-title { position: relative; z-index: 1; }

/* Píldoras */
.btn-pill {
  display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
  padding: .85rem 1.9rem; border-radius: var(--radius-pill);
  font-family: var(--font-display); font-weight: 600; font-size: .92rem; letter-spacing: .02em;
  transition: transform .3s var(--ease-out), box-shadow .3s var(--ease-out), background-color .3s var(--ease-out);
  min-height: 44px;
}
.btn-pill:active { transform: scale(0.97); }
.btn-pill-red {
  background: var(--red); color: #fff;
  box-shadow: 0 10px 26px -8px var(--red-glow);
}
.btn-pill-red:hover { background: var(--red-deep); transform: translateY(-2px); box-shadow: 0 14px 30px -8px var(--red-glow); }
.btn-pill-outline {
  border: 1.5px solid var(--red); color: var(--white);
}
.btn-pill-outline:hover { background: var(--red); transform: translateY(-2px); }
.btn-pill-dark {
  background: var(--card-dark-2); color: var(--white);
}
.btn-pill-dark:hover { background: #333; transform: translateY(-2px); }

/* Inputs underline */
.field-underline { position: relative; }
.field-underline label {
  display: block; font-size: .82rem; color: var(--grey); margin-bottom: .4rem;
}
.field-underline input, .field-underline select, .field-underline textarea {
  width: 100%; padding-block: .55rem; border-bottom: 1.5px solid var(--grey-line);
  font-size: .95rem; transition: border-color .3s var(--ease-out);
}
.field-underline.on-dark input, .field-underline.on-dark select, .field-underline.on-dark textarea { color: #fff; border-bottom-color: rgba(255,255,255,0.35); }
.field-underline textarea { resize: vertical; min-height: 70px; }
.field-underline input:focus, .field-underline select:focus, .field-underline textarea:focus {
  outline: none; border-bottom-color: var(--red);
}
.field-underline select { appearance: none; background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='9' viewBox='0 0 14 9'><path d='M1 1l6 6 6-6' stroke='%239a9a9a' stroke-width='2' fill='none'/></svg>"); background-repeat: no-repeat; background-position: right center; }

/* =============================================================
   6. Header
   ============================================================= */
.site-header {
  position: fixed; inset-inline: 0; top: 0; z-index: 500;
  height: var(--header-h);
  display: flex; align-items: center;
  background: linear-gradient(180deg, rgba(5,6,8,.72) 0%, rgba(5,6,8,.4) 80%, rgba(5,6,8,.15) 100%);
  border-bottom: 1px solid rgba(245,245,245,.1);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  transition: background-color .4s var(--ease-out), transform .4s var(--ease-out), height .3s var(--ease-out);
}
.site-header.is-scrolled {
  background: rgba(10,10,10,0.88);
  backdrop-filter: blur(10px);
  height: 84px;
  box-shadow: 0 6px 24px rgba(0,0,0,0.35);
}
.site-header.is-hidden { transform: translateY(-100%); }
.header-inner { display: flex; align-items: center; justify-content: space-between; width: 100%; gap: 1.5rem; }
.header-logo { display: flex; align-items: center; flex: none; }
.site-header .header-logo-image { display: block; width: 175px; height: 99px; max-width: none; object-fit: contain; object-position: center; }
.site-header.is-scrolled .header-logo-image { width: 148px; height: 84px; }
@media (max-width: 700px) {
  :root { --header-h: 84px; }
  .site-header .header-logo-image { width: 143px; height: 81px; }
  .site-header.is-scrolled .header-logo-image { width: 126px; height: 71px; }
}
.header-nav { display: none; align-items: center; gap: 2.2rem; }
.header-nav a {
  position: relative; font-size: .92rem; font-weight: 600; letter-spacing: .02em; color: var(--white);
  padding-block: .4rem; transition: color .25s var(--ease-out);
  text-shadow: 0 1px 6px rgba(0,0,0,.7);
}
.header-nav a::after {
  content: ""; position: absolute; left: 0; right: 100%; bottom: -2px; height: 3px; border-radius: 2px;
  background: var(--blue); transition: right .3s var(--ease-out);
}
.header-nav a:hover { color: var(--blue); }
.header-nav a:hover::after { right: 0; }
.header-nav a[aria-current="page"] { color: var(--blue); }
.header-nav a[aria-current="page"]::after { right: 0; }
.header-actions { display: flex; align-items: center; gap: 1.4rem; }
.header-actions .btn-pill { display: none; }
.header-phone { display: none; align-items: center; gap: .5rem; font-weight: 600; font-size: .95rem; }
.header-phone svg { width: 18px; height: 18px; color: var(--red); }
.header-actions .btn-pill-red svg { width: 16px; height: 16px; transition: transform .3s var(--ease-out); }
.header-actions .btn-pill-red:hover svg { transform: translateX(3px); }
.header-burger { display: inline-flex; width: 26px; height: 20px; flex-direction: column; justify-content: space-between; }
.header-burger { width: 44px; height: 44px; padding: 12px 9px; }
.header-burger span { display: block; height: 2px; background: var(--white); border-radius: 2px; transition: transform .3s var(--ease-out), opacity .3s var(--ease-out); }
.header-burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(9px) rotate(45deg); }
.header-burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
.header-burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-9px) rotate(-45deg); }

.mobile-nav {
  position: fixed; inset: var(--header-h) 0 0 0; z-index: 480;
  background: rgba(8,8,8,0.98);
  padding: 2rem var(--gutter);
  display: flex; flex-direction: column; gap: 1.4rem;
  transform: translateY(-16px); opacity: 0; pointer-events: none;
  transition: opacity .3s var(--ease-out), transform .3s var(--ease-out);
}
.mobile-nav.is-open { opacity: 1; transform: translateY(0); pointer-events: auto; }
.mobile-nav a { font-size: 1.3rem; font-weight: 500; border-bottom: 1px solid var(--grey-line); padding-bottom: .8rem; }
.mobile-nav .btn-pill { margin-top: .5rem; }
@media (max-width: 959px) {
  .mobile-nav {
    position: absolute; inset: auto 0 auto 0; top: 100%;
    height: calc(100dvh - var(--header-h));
    overflow-y: auto; overscroll-behavior: contain;
  }
}

@media (min-width: 960px) {
  .header-nav { display: flex; }
  .header-phone { display: flex; }
  .header-actions .btn-pill { display: inline-flex; }
  .header-burger { display: none; }
}

/* =============================================================
   7. Hero
   ============================================================= */
.hero { position: relative; background: #060708; }

/* The photo is never cropped: it sits in normal flow at width:100%/height:auto,
   so .hero-photo-wrap sizes itself exactly to the photo's own aspect ratio.
   Every piece of hero content is positioned in % over that same box, so it
   stays anchored to the same point of the photo at any screen size, and
   container-query units (cqw) scale type/spacing with the photo's own width. */
.hero-photo-wrap {
  position: relative;
  container-type: inline-size;
  container-name: hero;
  line-height: 0;
  isolation: isolate;
}
.hero-photo { display: block; width: 100%; height: auto; }

.hero-scrim { position: absolute; inset: 0; pointer-events: none; }
.hero-scrim-x {
  z-index: 1;
  background: linear-gradient(92deg,
    rgba(4,5,7,0.9) 0%, rgba(4,5,7,0.78) 26%, rgba(4,5,7,0.5) 45%,
    rgba(4,5,7,0.2) 60%, rgba(4,5,7,0.04) 72%, transparent 82%);
}
.hero-scrim-bottom {
  z-index: 1;
  background: linear-gradient(0deg, rgba(4,5,7,0.68) 0%, rgba(4,5,7,0.3) 18%, transparent 40%);
}
.hero-scrim-top {
  z-index: 1;
  background: linear-gradient(180deg, rgba(4,5,7,0.55) 0%, transparent 16%);
}
.hero-vignette {
  z-index: 1;
  background: radial-gradient(120% 100% at 50% 45%, transparent 58%, rgba(0,0,0,0.32) 100%);
}

.hero-overlay { position: absolute; inset: 0; z-index: 2; }
.hero-overlay > * { position: absolute; left: 7%; }

.hero-eyebrow {
  top: 27%;
  display: flex; align-items: center; gap: clamp(.5rem, 1.1cqw, .8rem);
  font-family: var(--font-display); font-weight: 500; font-style: italic;
  font-size: clamp(.62rem, 1.25cqw, .92rem); letter-spacing: .35em; text-transform: uppercase;
  color: var(--white); text-shadow: 0 2px 10px rgba(0,0,0,.6);
  white-space: nowrap;
}
.eyebrow-line {
  width: clamp(20px, 3.2cqw, 34px); height: 3px; border-radius: 2px; flex: none;
  background: linear-gradient(90deg, var(--red) 0 48%, var(--blue) 52% 100%);
  transform-origin: left center;
}
.eyebrow-text .glyph { display: inline-block; }

.hero-h1 {
  top: 32%;
  max-width: 44%;
  font-weight: 800; text-transform: none; font-style: italic;
  font-size: clamp(1.15rem, 4.15cqw, 3.5rem); line-height: .9; letter-spacing: -.01em;
}
.hero-h1 .h1-line {
  display: block; position: relative; overflow: visible;
}
.hero-h1 .h1-clip {
  display: inline-block; overflow: hidden; transform: skewX(-4deg); padding-right: .18em; margin-right: -.18em;
  text-shadow: 0 4px 18px rgba(0,0,0,.55);
}
.hero-h1 .h1-blue .h1-clip { color: var(--blue); text-shadow: 0 0 26px rgba(73,129,252,.55), 0 4px 18px rgba(0,0,0,.5); }
.hero-h1 .h1-red .h1-clip { color: var(--red); text-shadow: 0 0 26px rgba(220,0,0,.55), 0 4px 18px rgba(0,0,0,.5); }
.hero-h1 .h1-shine {
  position: absolute; top: 0; bottom: 0; left: -30%; width: 22%;
  background: linear-gradient(100deg, transparent 0%, rgba(255,255,255,.55) 45%, transparent 90%);
  transform: skewX(-18deg);
  mix-blend-mode: overlay;
  pointer-events: none;
}

.hero-sub2 {
  top: 64%;
  display: flex; gap: clamp(.6rem, 1.2cqw, .9rem);
  max-width: 36%;
  font-style: italic; color: var(--white); opacity: .88;
  font-size: clamp(.68rem, 1.55cqw, 1.08rem); line-height: 1.35;
  text-shadow: 0 2px 10px rgba(0,0,0,.6);
}
.hero-sub2 .sub-bar { width: 3px; flex: none; background: var(--blue); transform-origin: top; border-radius: 2px; }

.hero-cta-row { top: 72%; display: flex; align-items: center; gap: 0; }
.hero-quote-btn {
  position: relative; overflow: hidden;
  display: inline-flex; align-items: center; gap: clamp(.4rem, 1cqw, .7rem);
  padding: clamp(.55rem, 1.3cqw, 1rem) clamp(1rem, 2.4cqw, 1.7rem);
  border-radius: 999px; background: var(--red); color: #fff;
  font-family: var(--font-display); font-weight: 600; white-space: nowrap;
  font-size: clamp(.7rem, 1.4cqw, 1rem);
  box-shadow: 0 10px 26px -8px var(--red-glow);
  transition: transform .3s var(--ease-out), box-shadow .3s var(--ease-out);
}
.hero-quote-btn svg { width: clamp(14px, 1.5cqw, 18px); height: clamp(14px, 1.5cqw, 18px); transition: transform .3s var(--ease-out); }
.hero-quote-btn::before {
  content: ""; position: absolute; inset: 0; left: -60%; width: 40%;
  background: linear-gradient(100deg, transparent, rgba(255,255,255,.55), transparent);
  transform: skewX(-20deg);
}
.hero-quote-btn:hover { transform: translateY(-2px); box-shadow: 0 14px 30px -8px var(--red-glow); }
.hero-quote-btn:hover svg { transform: translateX(3px); }
.hero-quote-btn:hover::before { animation: quoteSheen .9s var(--ease-out); }
.hero-quote-btn:active { transform: scale(.97); }
@keyframes quoteSheen { from { left: -60%; } to { left: 130%; } }

.hero-watch-btn {
  display: inline-flex; align-items: center; gap: clamp(.5rem, 1.1cqw, .8rem);
  font-family: var(--font-body); font-weight: 600; color: var(--white);
  font-size: clamp(.68rem, 1.35cqw, .95rem); white-space: nowrap;
}
.hero-watch-btn .watch-ring {
  position: relative;
  display: inline-flex; align-items: center; justify-content: center;
  width: clamp(28px, 3.4cqw, 42px); height: clamp(28px, 3.4cqw, 42px); border-radius: 50%;
  border: 1.5px solid rgba(245,245,245,.55);
  transition: background-color .25s var(--ease-out), transform .3s var(--ease-out);
}
.hero-watch-btn .watch-ring::before {
  content: ""; position: absolute; inset: -6px; border-radius: 50%;
  border: 1.5px solid rgba(245,245,245,.4);
  animation: watchPulse 2.2s var(--ease-out) infinite;
}
.hero-watch-btn .watch-ring svg { width: 38%; height: 38%; margin-left: 8%; }
.hero-watch-btn:hover .watch-ring { background: rgba(255,255,255,.1); transform: scale(1.06); }
@keyframes watchPulse { 0% { transform: scale(.92); opacity: .6; } 70%,100% { transform: scale(1.28); opacity: 0; } }

.hero-feat-row {
  top: 84%; right: 5%; width: 88%;
  display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(.8rem, 1.6cqw, 1.6rem);
  padding-top: clamp(.8rem, 1.6cqw, 1.4rem);
  border-top: 1px solid rgba(245,245,245,.16);
}
.hero-feat-row li { position: relative; display: flex; align-items: flex-start; gap: clamp(.4rem, 1cqw, .7rem); }
.hero-feat-row .feat-divider {
  position: absolute; left: calc(-1 * clamp(.4rem, .8cqw, .8rem)); top: 0; bottom: 0; width: 1px;
  background: rgba(245,245,245,.18); transform-origin: top;
}
.hero-feat-row svg {
  width: clamp(16px, 2.1cqw, 24px); height: clamp(16px, 2.1cqw, 24px); flex: none; color: var(--blue);
  margin-top: .1em; transition: transform .3s var(--ease-out);
}
.hero-feat-row li:hover svg { transform: translateY(-2px) scale(1.08); }
.hero-feat-row strong {
  display: block; font-family: var(--font-display); font-size: clamp(.6rem, 1.05cqw, .82rem); font-weight: 600;
  letter-spacing: .03em; text-transform: uppercase; color: var(--white);
  text-shadow: 0 2px 8px rgba(0,0,0,.6);
}
.hero-feat-row span {
  display: block; font-size: clamp(.58rem, 1.02cqw, .82rem); color: var(--white); opacity: .68; margin-top: .2em; line-height: 1.35;
  text-shadow: 0 2px 8px rgba(0,0,0,.6);
}

/* ---- Below 1024px: photo shows in full above, content flows in a solid block below ---- */
@container hero (max-width: 1023px) {
  .hero-overlay {
    position: static;
    display: flex; flex-direction: column; align-items: flex-start;
    background: #060708; padding: 2rem var(--gutter) 2.4rem;
  }
  .hero-overlay > * { position: static; left: auto; top: auto; right: auto; max-width: none; width: auto; }
  .hero-scrim-x, .hero-vignette { display: none; }
  .hero-scrim-bottom { height: 30%; background: linear-gradient(0deg, #060708 0%, rgba(6,7,8,.6) 55%, transparent 100%); }
  .hero-eyebrow, .hero-h1, .hero-sub2 { font-size: revert; }
  .hero-eyebrow { font-size: .78rem; letter-spacing: .28em; margin-bottom: 1rem; }
  .hero-h1 { font-size: clamp(2.1rem, 9vw, 3.2rem); max-width: none; margin-bottom: 1.2rem; }
  .hero-sub2 { font-size: 1rem; max-width: 42ch; margin-bottom: 1.6rem; }
  .hero-cta-row { margin-bottom: 2rem; flex-wrap: wrap; }
  .hero-quote-btn, .hero-watch-btn { font-size: 1rem; }
  .hero-quote-btn svg { width: 18px; height: 18px; }
  .hero-watch-btn .watch-ring { width: 42px; height: 42px; }
  .hero-feat-row { width: 100%; grid-template-columns: repeat(2, 1fr); gap: 1.4rem 1.2rem; }
  .hero-feat-row strong, .hero-feat-row span { font-size: .82rem; }
  .hero-feat-row .feat-divider { display: none; }
}

/* =============================================================
   8. Brands
   ============================================================= */
/* Sección con foto de fondo a pantalla completa, mismo tratamiento que el
   hero (misma foto sin recortar, mismos degradados) para que ambas
   secciones se sientan como parte de una sola composición. */
.brands-section { padding-block: 0; background: #060708; }
.brands-section .hero-photo-wrap { isolation: isolate; }
.brands-overlay {
  position: absolute; inset: 0; z-index: 2;
  display: flex; flex-direction: column; align-items: center; text-align: center;
  padding: clamp(1.4rem, 4cqw, 3rem) clamp(1rem, 4cqw, 3rem);
}
.brands-overlay .brands-head { justify-content: center; margin-bottom: .6rem; }
.brands-overlay .split-title {
  font-size: clamp(1.05rem, 3.3cqw, 2.2rem);
  text-shadow: 0 3px 14px rgba(0,0,0,.7);
}
.brands-overlay .brands-sub {
  text-align: center; color: var(--white); opacity: .88;
  text-shadow: 0 2px 10px rgba(0,0,0,.7);
  font-size: clamp(.66rem, 1.35cqw, .95rem);
  margin-bottom: 0;
}
.brands-overlay .brands-track { margin-top: auto; padding-top: clamp(1rem, 3cqw, 2rem); }
@container hero (max-width: 1023px) {
  .brands-overlay {
    position: static;
    background: #060708; padding: 2rem var(--gutter) 2.4rem;
  }
  .brands-overlay .brands-head { justify-content: center; }
  .brands-overlay .split-title { font-size: clamp(1.6rem, 7vw, 2.4rem); }
  .brands-overlay .brands-sub { font-size: .95rem; margin-bottom: 1.4rem; }
  .brands-overlay .brands-track { margin-top: 0; padding-top: 0; }
}

.brands-head {
  display: flex; align-items: center; justify-content: flex-end; gap: 1rem;
  margin-bottom: .8rem;
}
.brands-head .rule { width: 46px; height: 2px; background: var(--blue); }
.brands-sub { text-align: right; color: var(--grey); font-size: .92rem; margin-bottom: 2rem; }
.brands-track {
  display: flex; gap: 1.6rem; overflow-x: auto; padding-block: .5rem 1rem;
  scrollbar-width: none; justify-content: center;
}
.brands-track::-webkit-scrollbar { display: none; }
.brand-item {
  flex: 0 0 auto; width: 118px; display: flex; flex-direction: column; align-items: center; gap: .7rem;
  background: none; border: 0; padding: 0; cursor: pointer; font-family: inherit;
}
.brand-btn {
  position: relative;
  width: 92px; height: 92px; border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #232323, #111 70%);
  border: 1px solid rgba(245,245,245,0.12);
  display: flex; align-items: center; justify-content: center;
  padding: 1.1rem;
  transition: border-color .3s var(--ease-out), box-shadow .3s var(--ease-out), transform .3s var(--ease-out);
  color: var(--white);
}
.brand-btn img { display: block; width: 100%; height: 100%; min-width: 0; min-height: 0; flex-shrink: 1; object-fit: contain; opacity: .92; transition: transform .35s var(--ease-out), opacity .35s var(--ease-out); }
.brand-item[data-brand="Chevrolet"] .brand-btn img { clip-path: inset(0 13% 0 0); }
.brand-item[data-brand="Suzuki"] .brand-btn { padding: .7rem; }
.brand-btn-other {
  font-family: var(--font-display); font-weight: 600; font-size: .8rem; letter-spacing: .03em;
  color: var(--grey); text-transform: uppercase;
}
.brand-item[aria-current="true"] .brand-btn {
  border-color: rgba(245,245,245,0.7); box-shadow: 0 0 0 3px rgba(245,245,245,0.08);
}
.brand-item[aria-current="true"] .brand-btn::before {
  content: ""; position: absolute; inset: -6px; border-radius: 50%;
  border: 1.5px solid var(--red); opacity: .5;
  animation: brandPulse 1.8s var(--ease-out) infinite;
}
@keyframes brandPulse {
  0% { transform: scale(0.94); opacity: .55; }
  70% { transform: scale(1.18); opacity: 0; }
  100% { transform: scale(1.18); opacity: 0; }
}
.brand-label {
  font-size: .74rem; line-height: 1.3; text-align: center; color: var(--grey);
  letter-spacing: .01em;
}
.brand-item:active .brand-btn { transform: scale(0.94); }
@media (hover: hover) and (pointer: fine) {
  .brand-item:nth-child(odd) .brand-btn:hover { border-color: var(--red); box-shadow: 0 0 24px -4px var(--red-glow); }
  .brand-item:nth-child(even) .brand-btn:hover { border-color: var(--blue); box-shadow: 0 0 24px -4px var(--blue-glow); }
  .brand-btn:hover img { transform: scale(1.1); opacity: 1; }
  .brand-item:hover .brand-label { color: var(--white); }
}

/* =============================================================
   9. Used Cars in Stock
   ============================================================= */
.stock-section { position: relative; background: var(--bg-soft); overflow: clip; }
.stock-glow {
  position: absolute; left: 50%; top: 20%; width: 900px; height: 900px;
  transform: translateX(-50%);
  background: radial-gradient(circle, rgba(225,29,42,0.12), transparent 65%);
  pointer-events: none;
}
.stock-lights {
  position: absolute; right: 3%; top: 12%; z-index: 0;
  display: grid; grid-template-columns: repeat(3, 34px); gap: 18px;
  opacity: .5;
}
.stock-lights span { width: 34px; height: 34px; border-radius: 50%; background: radial-gradient(circle, rgba(245,245,245,0.35), transparent 70%); }

.cars-grid { position: relative; z-index: 1; display: grid; gap: 1.6rem; grid-template-columns: 1fr; }
@media (min-width: 720px) { .cars-grid { grid-template-columns: 1fr 1fr; } }

.car-card {
  display: grid; grid-template-columns: 1fr 1fr; min-height: 200px;
  border-radius: 6px; overflow: clip; background: var(--white);
  transition: transform .4s var(--ease-out), box-shadow .4s var(--ease-out);
}
.car-card.is-dark { background: var(--card-dark-2); color: var(--white); }
.car-card:hover { transform: translateY(-5px); box-shadow: 0 24px 50px -20px rgba(0,0,0,0.5); }

.car-info { position: relative; padding: 1.3rem 1.4rem; display: flex; flex-direction: column; gap: .6rem; color: #17181a; transition: background-color .4s var(--ease-out), color .4s var(--ease-out); }
.car-card.is-dark .car-info { color: var(--white); }
.car-card:not(.is-dark):hover .car-info { background: var(--card-dark-2); color: var(--white); }
.car-card:not(.is-dark):hover .car-submit { color: #b5b5b5; }
.car-card:not(.is-dark):hover .car-km { color: #b5b5b5; }
.car-card:not(.is-dark):hover .car-specs { color: #a0a0a0; }
.car-info::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--red); }
.car-submit { font-size: .72rem; color: #9a9a9a; }
.car-title {
  font-size: 1.05rem; font-weight: 600;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.car-desc {
